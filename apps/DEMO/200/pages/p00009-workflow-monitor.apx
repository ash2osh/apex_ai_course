page 9 (
    name: Workflow Monitor
    alias: WORKFLOW-MONITOR
    title: Leave Workflow Monitor
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @is-admin
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Workflow Monitor
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
        }
    )

    region workflow-report (
        name: Workflow Executions & Correlated Requests
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.request_id,
                       u.full_name as employee_name,
                       t.leave_type_name,
                       r.requested_days,
                       r.status,
                       r.workflow_id,
                       (select count(*) from hr_leave_request_events e where e.request_id = r.request_id) as event_count,
                       r.created_at,
                       r.updated_at
                  from hr_leave_requests r
                  join hr_users u on u.user_id = r.user_id
                  join hr_leave_types t on t.leave_type_id = r.leave_type_id
                 order by r.created_at desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        advanced {
            savedReportMappingIdentifier: 8640973292069178
        }

        column CREATED_AT (
            type: plainText
            heading {
                heading: Initiated Date
            }
            layout {
                sequence: 80
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: A
            }
        )

        column EMPLOYEE_NAME (
            type: plainText
            heading {
                heading: Employee
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column EVENT_COUNT (
            type: plainText
            heading {
                heading: Total Events
            }
            layout {
                sequence: 70
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: C
            }
        )

        column LEAVE_TYPE_NAME (
            type: plainText
            heading {
                heading: Leave Type
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column REQUESTED_DAYS (
            type: plainText
            heading {
                heading: Days
            }
            layout {
                sequence: 40
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column REQUEST_ID (
            type: plainText
            heading {
                heading: Request ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Current Status
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column UPDATED_AT (
            type: plainText
            heading {
                heading: Last Update
            }
            layout {
                sequence: 90
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: H
            }
        )

        column WORKFLOW_ID (
            type: plainText
            heading {
                heading: Workflow ID
            }
            layout {
                sequence: 60
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CREATED_AT (
                sequence: 8
            )

            displayColumn EMPLOYEE_NAME (
                sequence: 2
            )

            displayColumn EVENT_COUNT (
                sequence: 7
            )

            displayColumn LEAVE_TYPE_NAME (
                sequence: 3
            )

            displayColumn REQUESTED_DAYS (
                sequence: 4
            )

            displayColumn REQUEST_ID (
                sequence: 1
            )

            displayColumn STATUS (
                sequence: 5
            )

            displayColumn UPDATED_AT (
                sequence: 9
            )

            displayColumn WORKFLOW_ID (
                sequence: 6
            )

        )

    )

)
