page 6 (
    name: Employee Leave History
    alias: EMPLOYEE-LEAVE-HISTORY
    title: Employee Leave History
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @is-admin
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Employee Leave History
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
        }
    )

    region filter-region (
        name: Filter by Employee
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region history-report (
        name: Leave History
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.request_id,
                       u.full_name as employee_name,
                       t.leave_type_name,
                       r.start_date,
                       r.end_date,
                       r.requested_days,
                       r.status,
                       coalesce(r.reason, '-') as reason,
                       r.created_at
                  from hr_leave_requests r
                  join hr_users u on u.user_id = r.user_id
                  join hr_leave_types t on t.leave_type_id = r.leave_type_id
                 where (:P6_USER_ID is null or r.user_id = to_number(:P6_USER_ID))
                 order by r.created_at desc
                ```
            pageItemsToSubmit: P6_USER_ID
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        advanced {
            savedReportMappingIdentifier: 8633963066069156
        }

        column CREATED_AT (
            type: plainText
            heading {
                heading: Submitted
            }
            layout {
                sequence: 90
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: A
            }
        )

        column EMPLOYEE_NAME (
            type: plainText
            heading {
                heading: Employee
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column END_DATE (
            type: plainText
            heading {
                heading: End Date
            }
            layout {
                sequence: 50
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: C
            }
        )

        column LEAVE_TYPE_NAME (
            type: plainText
            heading {
                heading: Leave Type
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column REASON (
            type: plainText
            heading {
                heading: Reason
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column REQUESTED_DAYS (
            type: plainText
            heading {
                heading: Days
            }
            layout {
                sequence: 60
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column REQUEST_ID (
            type: plainText
            heading {
                heading: Request ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: G
            }
        )

        column START_DATE (
            type: plainText
            heading {
                heading: Start Date
            }
            layout {
                sequence: 40
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: H
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CREATED_AT (
                sequence: 9
            )

            displayColumn EMPLOYEE_NAME (
                sequence: 2
            )

            displayColumn END_DATE (
                sequence: 5
            )

            displayColumn LEAVE_TYPE_NAME (
                sequence: 3
            )

            displayColumn REASON (
                sequence: 8
            )

            displayColumn REQUESTED_DAYS (
                sequence: 6
            )

            displayColumn REQUEST_ID (
                sequence: 1
            )

            displayColumn START_DATE (
                sequence: 4
            )

            displayColumn STATUS (
                sequence: 7
            )

        )

    )

    pageItem P6_USER_ID (
        type: selectList
        label {
            label: Select Employee
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @employees
        }
        layout {
            sequence: 10
            region: @filter-region
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Select an employee to filter their complete leave history.
        }
    )

)
