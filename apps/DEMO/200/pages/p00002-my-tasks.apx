page 2 (
    name: My Tasks
    alias: MY-TASKS
    title: My Assigned Tasks
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @is-manager-or-admin
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: My Tasks
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
        }
    )

    region tasks-report (
        name: Tasks Awaiting Your Action
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.request_id,
                       u.full_name as employee_name,
                       coalesce(d.department_name, 'Engineering') as department_name,
                       t.leave_type_name,
                       r.start_date,
                       r.end_date,
                       r.requested_days,
                       r.status,
                       r.created_at as submitted_date
                  from hr_leave_requests r
                  join hr_users u on u.user_id = r.user_id
                  join hr_leave_types t on t.leave_type_id = r.leave_type_id
                  left join hr_departments d on d.department_id = u.department_id
                 where r.status in ('SUBMITTED', 'PENDING', 'PENDING_MANAGER_APPROVAL', 'PENDING_HR_APPROVAL')
                   and (
                        (hr_auth_pkg.is_manager(:APP_USER) and u.manager_id = hr_user_pkg.current_user_id)
                        or hr_auth_pkg.is_admin(:APP_USER)
                       )
                 order by r.created_at asc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        advanced {
            savedReportMappingIdentifier: 8627011155069134
        }

        column DEPARTMENT_NAME (
            type: plainText
            heading {
                heading: Department
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column EMPLOYEE_NAME (
            type: plainText
            heading {
                heading: Employee
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column END_DATE (
            type: plainText
            heading {
                heading: End Date
            }
            layout {
                sequence: 60
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: C
            }
        )

        column LEAVE_TYPE_NAME (
            type: plainText
            heading {
                heading: Leave Type
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column REQUESTED_DAYS (
            type: plainText
            heading {
                heading: Days
            }
            layout {
                sequence: 70
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column REQUEST_ID (
            type: plainText
            heading {
                heading: Request ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column START_DATE (
            type: plainText
            heading {
                heading: Start Date
            }
            layout {
                sequence: 50
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: G
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column SUBMITTED_DATE (
            type: plainText
            heading {
                heading: Submitted Date
            }
            layout {
                sequence: 90
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: I
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn DEPARTMENT_NAME (
                sequence: 3
            )

            displayColumn EMPLOYEE_NAME (
                sequence: 2
            )

            displayColumn END_DATE (
                sequence: 6
            )

            displayColumn LEAVE_TYPE_NAME (
                sequence: 4
            )

            displayColumn REQUESTED_DAYS (
                sequence: 7
            )

            displayColumn REQUEST_ID (
                sequence: 1
            )

            displayColumn START_DATE (
                sequence: 5
            )

            displayColumn STATUS (
                sequence: 8
            )

            displayColumn SUBMITTED_DATE (
                sequence: 9
            )

        )

    )

)
