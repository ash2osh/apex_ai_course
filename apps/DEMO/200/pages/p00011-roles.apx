page 11 (
    name: Roles
    alias: ROLES
    title: Roles & Permissions Administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @is-super-admin
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region assign-role-form (
        name: Assign User Role
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
            ]
        }
    )

    region breadcrumb (
        name: Roles
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
        }
    )

    region roles-report (
        name: User Role Assignments
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ur.user_role_id,
                       u.user_id,
                       u.username,
                       u.full_name,
                       r.role_id,
                       r.role_code,
                       r.role_name,
                       ur.created_at,
                       'Revoke' as revoke_action
                  from hr_user_roles ur
                  join hr_users u on u.user_id = ur.user_id
                  join hr_roles r on r.role_id = ur.role_id
                 order by u.user_id, r.role_id
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        advanced {
            savedReportMappingIdentifier: 8644907599069205
        }

        column CREATED_AT (
            type: plainText
            heading {
                heading: Granted Date
            }
            layout {
                sequence: 80
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: A
            }
        )

        column FULL_NAME (
            type: plainText
            heading {
                heading: Full Name
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        column REVOKE_ACTION (
            type: plainText
            heading {
                heading: Action
            }
            layout {
                sequence: 90
            }
            columnFormatting {
                htmlExpression: <a class="t-Button t-Button--danger t-Button--simple t-Button--tiny" href="f?p=&APP_ID.:11:&APP_SESSION.:REVOKE_ROLE:&DEBUG.:11:P11_REVOKE_USER_ROLE_ID:#USER_ROLE_ID#">Revoke</a>
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column ROLE_CODE (
            type: plainText
            heading {
                heading: Role Code
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column ROLE_ID (
            type: plainText
            heading {
                heading: Role ID
            }
            layout {
                sequence: 50
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: E
            }
        )

        column ROLE_NAME (
            type: plainText
            heading {
                heading: Role Name
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: F
            }
        )

        column USERNAME (
            type: plainText
            heading {
                heading: Username
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column USER_ID (
            type: plainText
            heading {
                heading: User ID
            }
            layout {
                sequence: 20
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: H
            }
        )

        column USER_ROLE_ID (
            type: plainText
            heading {
                heading: Assignment ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: I
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport primary (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn CREATED_AT (
                sequence: 8
            )

            displayColumn FULL_NAME (
                sequence: 4
            )

            displayColumn REVOKE_ACTION (
                sequence: 9
            )

            displayColumn ROLE_CODE (
                sequence: 6
            )

            displayColumn ROLE_ID (
                sequence: 5
            )

            displayColumn ROLE_NAME (
                sequence: 7
            )

            displayColumn USERNAME (
                sequence: 3
            )

            displayColumn USER_ID (
                sequence: 2
            )

            displayColumn USER_ROLE_ID (
                sequence: 1
            )

        )

    )

    pageItem P11_REVOKE_USER_ROLE_ID (
        type: hidden
        layout {
            sequence: 10
            region: @assign-role-form
            slot: regionBody
        }
    )

    pageItem P11_ROLE_ID (
        type: selectList
        label {
            label: Select Role
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @roles
        }
        layout {
            sequence: 30
            region: @assign-role-form
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        help {
            helpText: Role to assign: EMPLOYEE, MANAGER, ADMIN, or SUPER_ADMIN.
        }
    )

    pageItem P11_USER_ID (
        type: selectList
        label {
            label: Select User
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @all-users
        }
        layout {
            sequence: 20
            region: @assign-role-form
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        help {
            helpText: Select the user who will receive the role grant.
        }
    )

    button grant-role (
        buttonName: GRANT_ROLE
        label: Assign Role
        layout {
            sequence: 10
            region: @assign-role-form
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-plus-circle
        }
    )

    button reset-form (
        buttonName: RESET_FORM
        label: Clear Form
        layout {
            sequence: 20
            region: @assign-role-form
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            icon: fa-undo
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 11
                clearCache: 11
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process grant-role-process (
        name: Grant Role to User
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    insert into hr_user_roles (
                        user_id,
                        role_id,
                        created_by,
                        created_at
                    ) values (
                        to_number(:P11_USER_ID),
                        to_number(:P11_ROLE_ID),
                        coalesce(:APP_USER, user),
                        systimestamp
                    );
                    commit;
                    apex_application.g_print_success_message := 'Role assigned successfully.';
                exception
                    when dup_val_on_index then
                        apex_error.add_error (
                            p_message          => 'This user already possesses the selected role.',
                            p_display_location => apex_error.c_inline_in_notification
                        );
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Role assigned successfully.
        }
        advanced {
            executionMappingIdentifier: 8646756032069205
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: GRANT_ROLE
        }
    )

    process revoke-role-process (
        name: Revoke User Role
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_count number;
                begin
                    if :P11_REVOKE_USER_ROLE_ID is not null then
                        select count(*)
                          into l_count
                          from hr_user_roles ur
                          join hr_roles r on r.role_id = ur.role_id
                         where r.role_code = 'SUPER_ADMIN'
                           and ur.user_role_id = to_number(:P11_REVOKE_USER_ROLE_ID);
                        
                        if l_count > 0 then
                            select count(*)
                              into l_count
                              from hr_user_roles ur
                              join hr_roles r on r.role_id = ur.role_id
                             where r.role_code = 'SUPER_ADMIN';
                            
                            if l_count <= 1 then
                                raise_application_error(-20020, 'Cannot revoke the last SUPER_ADMIN role assignment in the system.');
                            end if;
                        end if;
                
                        delete from hr_user_roles where user_role_id = to_number(:P11_REVOKE_USER_ROLE_ID);
                        commit;
                        apex_application.g_print_success_message := 'Role assignment revoked successfully.';
                    end if;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Role assignment revoked successfully.
        }
        advanced {
            executionMappingIdentifier: 8646816256069205
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: REVOKE_ROLE
        }
    )

)
