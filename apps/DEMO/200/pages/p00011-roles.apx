page 11 (
    name: Roles
    alias: ROLES
    title: Roles & Permissions Administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @is-super-admin
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Roles
        type: breadcrumb
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
        }
        source {
            breadcrumb: @breadcrumb
        }
    )

    region roles-report (
        name: User Role Assignments
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ur.user_role_id,
                       u.user_id,
                       u.username,
                       u.full_name,
                       r.role_id,
                       r.role_code,
                       r.role_name,
                       ur.created_at
                  from hr_user_roles ur
                  join hr_users u on u.user_id = ur.user_id
                  join hr_roles r on r.role_id = ur.role_id
                 order by u.user_id, r.role_id
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZ
        }

        column CREATED_AT (
            type: plainText
            heading {
                heading: Granted Date
            }
            layout {
                sequence: 80
            }
            source {
                dataType: DATE
            }
        )

        column FULL_NAME (
            type: plainText
            heading {
                heading: Full Name
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column ROLE_CODE (
            type: plainText
            heading {
                heading: Role Code
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
        )

        column ROLE_ID (
            type: plainText
            heading {
                heading: Role ID
            }
            layout {
                sequence: 50
            }
            source {
                dataType: NUMBER
            }
        )

        column ROLE_NAME (
            type: plainText
            heading {
                heading: Role Name
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
        )

        column USERNAME (
            type: plainText
            heading {
                heading: Username
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column USER_ID (
            type: plainText
            heading {
                heading: User ID
            }
            layout {
                sequence: 20
            }
            source {
                dataType: NUMBER
            }
        )

        column USER_ROLE_ID (
            type: plainText
            heading {
                heading: Assignment ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

    )

)
