page 7 (
    name: Leave Types
    alias: LEAVE-TYPES
    title: Leave Types Policy Catalog
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @is-admin
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Leave Types
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
        }
    )

    region leave-type-form (
        name: Manage Leave Type
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--accent1
            ]
        }
    )

    region leave-types-report (
        name: Configured Leave Types
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select leave_type_id,
                       leave_type_code,
                       leave_type_name,
                       default_entitlement,
                       requires_balance_yn,
                       active_yn,
                       display_order,
                       created_at
                  from hr_leave_types
                 order by display_order
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        advanced {
            savedReportMappingIdentifier: 8635425028069175
        }

        column ACTIVE_YN (
            type: plainText
            heading {
                heading: Active
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: A
            }
        )

        column CREATED_AT (
            type: plainText
            heading {
                heading: Created Date
            }
            layout {
                sequence: 80
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: B
            }
        )

        column DEFAULT_ENTITLEMENT (
            type: plainText
            heading {
                heading: Default Entitlement (Days)
            }
            layout {
                sequence: 40
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: C
            }
        )

        column DISPLAY_ORDER (
            type: plainText
            heading {
                heading: Sort Order
            }
            layout {
                sequence: 70
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: D
            }
        )

        column LEAVE_TYPE_CODE (
            type: plainText
            heading {
                heading: Code
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression: <a href="f?p=&APP_ID.:7:&APP_SESSION.::&DEBUG.:7:P7_LEAVE_TYPE_ID,P7_LEAVE_TYPE_CODE,P7_LEAVE_TYPE_NAME,P7_DEFAULT_ENTITLEMENT,P7_REQUIRES_BALANCE_YN,P7_ACTIVE_YN,P7_DISPLAY_ORDER:#LEAVE_TYPE_ID#,#LEAVE_TYPE_CODE#,#LEAVE_TYPE_NAME#,#DEFAULT_ENTITLEMENT#,#REQUIRES_BALANCE_YN#,#ACTIVE_YN#,#DISPLAY_ORDER#">#LEAVE_TYPE_CODE#</a>
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column LEAVE_TYPE_ID (
            type: plainText
            heading {
                heading: Type ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column LEAVE_TYPE_NAME (
            type: plainText
            heading {
                heading: Leave Type Name
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: G
            }
        )

        column REQUIRES_BALANCE_YN (
            type: plainText
            heading {
                heading: Requires Balance
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }
    )

    pageItem P7_ACTIVE_YN (
        type: selectList
        label {
            label: Active Status
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @yes-no
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @leave-type-form
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: Y
        }
    )

    pageItem P7_DEFAULT_ENTITLEMENT (
        type: numberField
        label {
            label: Default Entitlement (Days)
            alignment: left
        }
        layout {
            sequence: 40
            region: @leave-type-form
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: 0
        }
        help {
            helpText: Default annual entitlement in days for new employees.
        }
    )

    pageItem P7_DISPLAY_ORDER (
        type: numberField
        label {
            label: Display Order
            alignment: left
        }
        layout {
            sequence: 70
            region: @leave-type-form
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: 10
        }
    )

    pageItem P7_LEAVE_TYPE_CODE (
        type: textField
        label {
            label: Leave Type Code
            alignment: left
        }
        layout {
            sequence: 20
            region: @leave-type-form
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        help {
            helpText: Unique uppercase identifier for the leave type (e.g. ANNUAL, SICK, UNPAID).
        }
    )

    pageItem P7_LEAVE_TYPE_ID (
        type: hidden
        layout {
            sequence: 10
            region: @leave-type-form
            slot: regionBody
        }
    )

    pageItem P7_LEAVE_TYPE_NAME (
        type: textField
        label {
            label: Leave Type Name
            alignment: left
        }
        layout {
            sequence: 30
            region: @leave-type-form
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        help {
            helpText: Descriptive name for the leave type.
        }
    )

    pageItem P7_REQUIRES_BALANCE_YN (
        type: selectList
        label {
            label: Requires Balance
            alignment: left
        }
        lov {
            type: sharedComponent
            lov: @yes-no
            displayNullValue: false
        }
        layout {
            sequence: 50
            region: @leave-type-form
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: Y
        }
    )

    button reset-form (
        buttonName: RESET_FORM
        label: Clear / New
        layout {
            sequence: 20
            region: @leave-type-form
            slot: previous
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            icon: fa-undo
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 7
                clearCache: 7
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button save-leave-type (
        buttonName: SAVE_LEAVE_TYPE
        label: Save Leave Type
        layout {
            sequence: 10
            region: @leave-type-form
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-save
        }
    )

    process save-leave-type-process (
        name: Save Leave Type Record
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    if :P7_LEAVE_TYPE_ID is null then
                        insert into hr_leave_types (
                            leave_type_code,
                            leave_type_name,
                            default_entitlement,
                            requires_balance_yn,
                            active_yn,
                            display_order,
                            created_by,
                            created_at
                        ) values (
                            upper(trim(:P7_LEAVE_TYPE_CODE)),
                            trim(:P7_LEAVE_TYPE_NAME),
                            nvl(to_number(:P7_DEFAULT_ENTITLEMENT), 0),
                            nvl(:P7_REQUIRES_BALANCE_YN, 'Y'),
                            nvl(:P7_ACTIVE_YN, 'Y'),
                            nvl(to_number(:P7_DISPLAY_ORDER), 10),
                            coalesce(:APP_USER, user),
                            systimestamp
                        ) returning leave_type_id into :P7_LEAVE_TYPE_ID;
                        apex_application.g_print_success_message := 'Leave type created successfully.';
                    else
                        update hr_leave_types
                           set leave_type_code     = upper(trim(:P7_LEAVE_TYPE_CODE)),
                               leave_type_name     = trim(:P7_LEAVE_TYPE_NAME),
                               default_entitlement = nvl(to_number(:P7_DEFAULT_ENTITLEMENT), 0),
                               requires_balance_yn = nvl(:P7_REQUIRES_BALANCE_YN, 'Y'),
                               active_yn           = nvl(:P7_ACTIVE_YN, 'Y'),
                               display_order       = nvl(to_number(:P7_DISPLAY_ORDER), 10),
                               updated_by          = coalesce(:APP_USER, user),
                               updated_at          = systimestamp
                         where leave_type_id = to_number(:P7_LEAVE_TYPE_ID);
                        apex_application.g_print_success_message := 'Leave type updated successfully.';
                    end if;
                    commit;
                exception
                    when dup_val_on_index then
                        apex_error.add_error (
                            p_message          => 'A leave type with this code already exists.',
                            p_display_location => apex_error.c_inline_in_notification
                        );
                end;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Leave type saved successfully.
        }
        advanced {
            executionMappingIdentifier: 8637661830069177
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: SAVE_LEAVE_TYPE
        }
    )

)
