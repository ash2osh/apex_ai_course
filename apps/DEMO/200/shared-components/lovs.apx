lov leave-types (
    name: LEAVE_TYPES
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select leave_type_name as d,
                   leave_type_code as r
              from hr_leave_types
             where active_yn = 'Y'
             order by display_order
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov request-statuses (
    name: REQUEST_STATUSES
    source {
        location: staticValues
    }

    entry approved (
        sequence: 30
        display: Approved
        return: APPROVED
    )

    entry cancelled (
        sequence: 50
        display: Cancelled
        return: CANCELLED
    )

    entry pending-hr-approval (
        sequence: 20
        display: Pending HR Approval
        return: PENDING_HR_APPROVAL
    )

    entry pending-manager-approval (
        sequence: 10
        display: Pending Manager Approval
        return: PENDING_MANAGER_APPROVAL
    )

    entry rejected (
        sequence: 40
        display: Rejected
        return: REJECTED
    )

    entry submitted (
        sequence: 5
        display: Submitted
        return: SUBMITTED
    )

    entry workflow-error (
        sequence: 60
        display: Workflow Error
        return: WORKFLOW_ERROR
    )

)

lov roles (
    name: ROLES
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select role_name as d,
                   to_char(role_id) as r
              from hr_roles
             order by role_id
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov unified-task-list-lov-due (
    name: UNIFIED_TASK_LIST.LOV.DUE
    source {
        location: staticValues
    }

    entry 0 (
        sequence: 1
        display: Overdue
        return: |0
    )

    entry 0-1 (
        sequence: 2
        display: Next hour
        return: 0|1
    )

    entry 1-24 (
        sequence: 3
        display: Next 24 hours
        return: 1|24
    )

    entry 168-720 (
        sequence: 5
        display: Next 30 days
        return: 168|720
    )

    entry 24-168 (
        sequence: 4
        display: Next 7 days
        return: 24|168
    )

    entry 720 (
        sequence: 6
        display: More than 30 days
        return: 720|
    )

)

lov unified-task-list-lov-initiated (
    name: UNIFIED_TASK_LIST.LOV.INITIATED
    source {
        location: staticValues
    }

    entry 1 (
        sequence: 1
        display: Last hour
        return: |1
