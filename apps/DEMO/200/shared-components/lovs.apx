    )

    entry 24-168 (
        sequence: 3
        display: Last 7 days
        return: 24|168
    )

    entry 720 (
        sequence: 5
        display: Older than 30 days
        return: 720|
    )

)

lov unified-task-list-lov-priority (
    name: UNIFIED_TASK_LIST.LOV.PRIORITY
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select disp,
                   val
              from table ( apex_human_task.get_lov_priority )
             order by insert_order
            ```
    }
    columnMapping {
        return: VAL
        display: DISP
    }
)

