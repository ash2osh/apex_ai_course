lov all-users (
    name: ALL_USERS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select full_name || ' (' || username || ')' || case when active_yn = 'N' then ' [Inactive]' end as d,
                   to_char(user_id) as r
              from hr_users
             order by full_name
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov balance-years (
    name: BALANCE_YEARS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select distinct to_char(balance_year) as d,
                   to_char(balance_year) as r
              from hr_leave_balances
             order by 1 desc
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov boolean (
    name: BOOLEAN
    source {
        location: staticValues
    }

    entry false (
        sequence: 2
        display: No
        return: FALSE
    )

    entry true (
        sequence: 1
        display: Yes
        return: TRUE
    )

)

lov departments (
    name: DEPARTMENTS
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select department_name as d,
                   to_char(department_id) as r
              from hr_departments
             where active_yn = 'Y'
             order by department_name
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

