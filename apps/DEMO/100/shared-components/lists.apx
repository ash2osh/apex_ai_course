list navigation-bar (
    name: Navigation Bar

    entry app-user (
        label: &APP_USER.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
    )

    entry list_item (
        label: ---
        layout {
            sequence: 20
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry sign-out (
        label: Sign Out
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 30
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

)

list navigation-menu (
    name: Navigation Menu

    entry home (
        label: Home
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: hr_auth_pkg.is_employee(:APP_USER)
        }
    )

    entry my-profile (
        label: My Profile
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 2
            }
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: hr_auth_pkg.is_employee(:APP_USER)
        }
    )

    entry leave (
        label: Leave
        icon {
            imageIconCssClasses: fa-calendar
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: hr_auth_pkg.is_employee(:APP_USER)
        }
    )

    entry my-leave-balances (
        label: My Leave Balances
        icon {
            imageIconCssClasses: fa-calculator
        }
        layout {
            sequence: 10
            parentEntry: @leave
        }
        link {
            target: {
                page: 3
            }
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: hr_auth_pkg.is_employee(:APP_USER)
        }
    )

    entry submit-leave-request (
        label: Submit Leave Request
        icon {
            imageIconCssClasses: fa-calendar-plus-o
        }
        layout {
            sequence: 20
            parentEntry: @leave
        }
        link {
            target: {
                page: 4
            }
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: hr_auth_pkg.is_employee(:APP_USER)
        }
    )

    entry my-leave-requests (
        label: My Leave Requests
        icon {
            imageIconCssClasses: fa-calendar-check-o
        }
        layout {
            sequence: 30
            parentEntry: @leave
        }
        link {
            target: {
                page: 5
            }
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: hr_auth_pkg.is_employee(:APP_USER)
        }
    )

    entry workflow-timeline (
        label: Workflow Timeline
        icon {
            imageIconCssClasses: fa-clock-o
        }
        layout {
            sequence: 40
            parentEntry: @leave
        }
        link {
            target: {
                page: 7
            }
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: hr_auth_pkg.is_employee(:APP_USER)
        }
    )

    entry hr-ai-assistant (
        label: HR AI Assistant
        icon {
            imageIconCssClasses: fa-comments
        }
        layout {
            sequence: 40
        }
        link {
            target: {
                page: 8
            }
        }
        userDefinedAttributes {
            1: AI Experience
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: hr_auth_pkg.is_employee(:APP_USER)
        }
    )

    entry hr-ai-agent (
        label: HR AI Agent
        icon {
            imageIconCssClasses: fa-android
        }
        layout {
            sequence: 50
        }
        link {
            target: {
                page: 9
            }
        }
        userDefinedAttributes {
            1: AI Experience
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression: hr_auth_pkg.is_employee(:APP_USER)
        }
    )

)
